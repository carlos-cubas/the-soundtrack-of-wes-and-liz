{
  "name": "the-soundtrack-of-wes-and-liz",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "ios:sync": "vite build && cap sync ios",
    "ios:open": "cap open ios",
    "ios:sim": "bash tools/ios_sim.sh",
    "ios:icons": "bash tools/ios_icons.sh",
    "ios:device": "bash tools/ios_device.sh"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "playwright": "^1.63.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.2",
    "@capacitor/ios": "^8.5.2"
  }
}
